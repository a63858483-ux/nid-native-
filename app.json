{
  "expo": {
    "name": "Nid douillet",
    "slug": "nid-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nid",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "top.xiaoketata.nid.native",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "EXDevMenuShowFloatingActionButton": false,
        "NSAppleMusicUsageDescription": "Nid plays the songs Antoine picks for you and shows your Apple Music library.",
        "NSAlarmKitUsageDescription": "Nid sets the alarms Antoine promises to wake you with."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nid uses your photos to set the chat wallpaper and to send pictures.",
          "cameraPermission": "Nid uses the camera to send photos in chat."
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Nid uses the microphone to record voice messages."
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc01345f-dd65-4965-8ed2-2760935ccf0a"
      }
    },
    "owner": "ada8899",
    "updates": {
      "url": "https://u.expo.dev/dc01345f-dd65-4965-8ed2-2760935ccf0a"
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
